{
  "name": "sakana-widget-react",
  "type": "module",
  "version": "0.3.0",
  "packageManager": "pnpm@10.30.1",
  "description": "A React component that wrap \"Sakana! Widget\".",
  "author": "pinkchampagne",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/p-toy-factory/sakana-widget-react"
  },
  "keywords": [
    "widget",
    "lycoris-recoil",
    "lycoris",
    "recoil",
    "chisato",
    "takina"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build-storybook": "storybook build",
    "dev": "pnpm run storybook",
    "format": "biome format .",
    "format:fix": "pnpm run format --write",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "prepublish": "pnpm run build",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:browser": "pnpm run test --project browser"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "sakana-widget": "2.7.1"
  },
  "dependencies": {
    "dequal": "^2.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@pinkchampagne/tsconfig": "^1.0.0",
    "@storybook/react-vite": "^10.2.8",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser-playwright": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-pcp": "2.0.0-beta.6",
    "eslint-plugin-storybook": "^0.12.0",
    "react-test-renderer": "^18.3.1",
    "storybook": "^10.2.8",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vitest-browser-react": "^2.0.5"
  }
}
