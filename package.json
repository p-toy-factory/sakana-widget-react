{
  "name": "sakana-widget-react",
  "version": "0.3.0",
  "description": "A React component that wrap \"Sakana! Widget\".",
  "keywords": [
    "chisato",
    "lycoris",
    "lycoris-recoil",
    "recoil",
    "takina",
    "widget"
  ],
  "license": "MIT",
  "author": "pinkchampagne",
  "repository": {
    "type": "git",
    "url": "https://github.com/p-toy-factory/sakana-widget-react"
  },
  "files": [
    "dist",
    "skills",
    "src/index.tsx",
    "src/hooks/use-isomorphic-layout-effect.ts",
    "src/hooks/use-merge-refs.ts",
    "src/hooks/use-structurally-stable-value.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build-storybook": "storybook build",
    "dev": "pnpm run storybook",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublish": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:browser": "pnpm run test --project browser"
  },
  "dependencies": {
    "dequal": "^2.0.3"
  },
  "devDependencies": {
    "@pinkchampagne/tsconfig": "^1.0.0",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.9",
    "happy-dom": "^20.10.6",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.72.0",
    "storybook": "^10.4.6",
    "tsdown": "^0.22.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.9",
    "vitest-browser-react": "^2.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "sakana-widget": "2.7.1"
  },
  "packageManager": "pnpm@11.7.0"
}
