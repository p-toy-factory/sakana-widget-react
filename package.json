{
  "name": "sakana-widget-react",
  "version": "1.0.0",
  "description": "A React component that wrap \"Sakana! Widget\".",
  "keywords": [
    "chisato",
    "lycoris",
    "lycoris-recoil",
    "recoil",
    "takina",
    "tanstack-intent",
    "widget"
  ],
  "license": "MIT",
  "author": "pinkchampagne",
  "repository": {
    "type": "git",
    "url": "https://github.com/p-toy-factory/sakana-widget-react"
  },
  "files": [
    "dist",
    "skills",
    "src/**/*.{tsx,ts}",
    "!src/**/*.{test,stories}.{tsx,ts}"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build-storybook": "storybook build",
    "dev": "pnpm run storybook",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublish": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:browser": "pnpm run test --project browser"
  },
  "dependencies": {
    "dequal": "^2.0.3"
  },
  "devDependencies": {
    "@pinkchampagne/tsconfig": "^1.0.0",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sakana-widget": "^3.0.0",
    "storybook": "^10.6.3",
    "tsdown": "^0.23.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "sakana-widget": "^2.7.1 || ^3.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
